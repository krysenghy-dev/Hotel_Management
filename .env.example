PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-production

# On Render/Railway/Replit-style hosts the filesystem resets on every
# deploy/restart unless this points inside a mounted persistent disk.
# Local dev: leave unset, it defaults to server/db/hoteldesk.db
# Render:   DB_PATH=/var/data/hoteldesk.db  (mount your disk at /var/data)
DB_PATH=
